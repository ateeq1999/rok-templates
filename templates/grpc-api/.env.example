# Copy to `.env` (or export these) and adjust. `src/config.rs` (the axum
# template's) reads them; a debug build (`cargo run`, `cargo test`) loads
# `.env` itself, a release build reads only the real environment. The
# settings only the HTTP API uses (rate limits, CORS, uploads) are read too,
# and have no effect here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grpc_api
# The axum API's secret, so its bearer tokens verify here (at least 32 bytes;
# make one with `openssl rand -base64 48`):
JWT_SECRET=change-me-to-a-long-random-string
# The axum API's key (32 bytes in base64; `openssl rand -base64 32`; this one
# is for local development only):
TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# What this process runs: all (the gRPC server and the job worker; the
# default), web (the server only) or worker (the jobs and the schedule; the
# health and reflection services only):
# APP_ROLE=all
BIND_ADDR=127.0.0.1:50051
# Serve /metrics (Prometheus) here, apart from the gRPC server (unset: no metrics):
# METRICS_ADDR=127.0.0.1:9090
# The secret being rotated out: tokens it signed still pass until they expire:
# JWT_SECRET_PREVIOUS=
# How mail leaves: log (logged, not sent; the default) or smtp:
# MAIL_TRANSPORT=log
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Axum API <no-reply@localhost>
# Background jobs run at once; each holds a pool connection while it runs
# (default 4):
# JOBS_CONCURRENCY=4
# On SIGTERM: seconds it keeps serving while the health service answers
# NOT_SERVING (default 5), then seconds calls in flight and running jobs
# have to finish (default 25):
# SHUTDOWN_DELAY_SECS=5
# SHUTDOWN_GRACE_SECS=25
# Pool settings, all optional:
# DB_MAX_CONNECTIONS=20
# DB_MIN_CONNECTIONS=5
# DB_ACQUIRE_TIMEOUT_SECS=3
# DB_IDLE_TIMEOUT_SECS=600
# DB_MAX_LIFETIME_SECS=1800
# The log filter (default info), such as debug or info,sqlx=warn:
# RUST_LOG=info
# How log lines are written: pretty (the default) or json:
# LOG_FORMAT=pretty
# Export every span over OTLP/HTTP to this collector (unset: nothing is
# exported):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=
